bucket = "terraform-state"
key    = "dev/terraform.tfstate"
region = "ru-central1"

# access_key / secret_key — через переменные окружения:
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#
# endpoint — через -backend-config в CI/CD:
#   terraform init -backend-config=... -backend-config="endpoints={s3=\"$MINIO_ENDPOINT\"}"
